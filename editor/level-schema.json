{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tower Defense Level",
  "type": "object",
  "required": [
    "version",
    "width",
    "height"
  ],
  "properties": {
    "version": {
      "type": "number",
      "description": "Level format version"
    },
    "name": {
      "type": "string",
      "description": "Level name"
    },
    "description": {
      "type": "string",
      "description": "Level description"
    },
    "width": {
      "type": "number",
      "minimum": 4,
      "maximum": 50,
      "description": "Grid width in tiles"
    },
    "height": {
      "type": "number",
      "minimum": 4,
      "maximum": 50,
      "description": "Grid height in tiles"
    },
    "path": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "description": "Path points for enemy movement"
    },
    "spawnPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "description": "Enemy spawn locations"
    },
    "basePoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "description": "Base/exit locations"
    },
    "bgTiles": {
      "type": "array",
      "description": "Background tiles at 2x grid resolution. Values are GLOBAL tile ids spanning all tilesets (see src/utils/tileRanges.ts); -1 = empty cell."
    },
    "areas": {
      "type": "array",
      "description": "Area overlay at background-tile resolution (2x grid, same as bgTiles): 'none' | 'tree' | 'wall' | 'roof'. Tree/wall block building; roof is sniper-only. Legacy grid-resolution layers are accepted and upgraded automatically."
    },
    "fgAreas": {
      "type": "array",
      "description": "Foreground markers at background-tile resolution (2x grid, same as bgTiles): 'fg' marks tiles that render above gameplay (depth 20); others render at depth 10. Invisible layer."
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "description": "Starting lives: easy=20, medium=5, hard=1 (default easy)"
    },
    "waves": {
      "type": "array",
      "description": "Custom wave definitions for this level. Each wave: { waveNumber, entries: [{ enemyType, count, spawnDelay, waveDelay }] }. Omit to use the game defaults.",
      "items": {
        "type": "object",
        "required": [
          "entries"
        ],
        "properties": {
          "waveNumber": {
            "type": "number"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "enemyType",
                "count"
              ],
              "properties": {
                "enemyType": {
                  "type": "string",
                  "enum": [
                    "basic",
                    "fast",
                    "armored",
                    "healer",
                    "swarm",
                    "tank",
                    "elite",
                    "boss"
                  ]
                },
                "count": {
                  "type": "number",
                  "minimum": 1
                },
                "spawnDelay": {
                  "type": "number",
                  "minimum": 0
                },
                "waveDelay": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "groundColor": {
      "type": "number",
      "description": "Fill color for light ground chessboard squares (0xRRGGBB)"
    },
    "groundColorDark": {
      "type": "number",
      "description": "Fill color for dark ground chessboard squares (0xRRGGBB)"
    },
    "roadColor": {
      "type": "number",
      "description": "Tint for road fill (0xRRGGBB)"
    },
    "roadColorDark": {
      "type": "number",
      "description": "Tint for road outline (0xRRGGBB)"
    },
    "tileSize": {
      "type": "number",
      "description": "Size of each tile in pixels"
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "description": "Legacy foreground tile grid (no longer produced by the editor; ignored by the game)"
    }
  }
}