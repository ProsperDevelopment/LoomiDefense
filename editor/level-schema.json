{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tower Defense Level",
  "type": "object",
  "required": ["version", "width", "height", "tileSize", "tiles"],
  "properties": {
    "version": {
      "type": "number",
      "description": "Level format version"
    },
    "name": {
      "type": "string",
      "description": "Level name"
    },
    "description": {
      "type": "string",
      "description": "Level description"
    },
    "width": {
      "type": "number",
      "minimum": 4,
      "maximum": 50,
      "description": "Grid width in tiles"
    },
    "height": {
      "type": "number",
      "minimum": 4,
      "maximum": 50,
      "description": "Grid height in tiles"
    },
    "tileSize": {
      "type": "number",
      "description": "Size of each tile in pixels"
    },
    "tileset": {
      "type": "string",
      "description": "Name of the tileset to use"
    },
    "tiles": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "description": "2D array of tile indices (-1 = empty)"
    },
    "path": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        },
        "required": ["x", "y"]
      },
      "description": "Path points for enemy movement"
    },
    "spawnPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        },
        "required": ["x", "y"]
      },
      "description": "Enemy spawn locations"
    },
    "basePoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        },
        "required": ["x", "y"]
      },
      "description": "Base/exit locations"
    }
  }
}
